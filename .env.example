# Base de datos Postgres (ej. Supabase, Neon, Railway).
# En Supabase: Project Settings > Database > Connection string.
#
# DATABASE_URL: conexión pooled (Supavisor, puerto 6543). La usa la app en
# tiempo de ejecución (funciones serverless de Netlify) — soporta IPv4.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# DIRECT_URL: conexión directa (host db.<project-ref>.supabase.co, puerto
# 5432). Solo la usa "prisma migrate ..." al correr LOCALMENTE (requiere
# salida IPv6, por eso nunca se usa desde el build de Netlify). En Netlify
# podés simplemente repetir el mismo valor de DATABASE_URL acá.
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres"

# Contraseña del panel de administración (obligatoria).
ADMIN_PASSWORD="cambiar-esta-contraseña"

# Secreto usado para firmar la cookie de sesión de administrador.
# Generá uno propio, por ejemplo con: openssl rand -hex 32
ADMIN_SESSION_SECRET="cambiar-este-secreto-por-uno-largo-y-aleatorio"

# Secreto para firmar la cookie de sesión de clientes (cuentas de la tienda,
# /mi-cuenta). Opcional: si no se define, se reutiliza ADMIN_SESSION_SECRET.
# Se recomienda definir uno propio y distinto en producción.
CUSTOMER_SESSION_SECRET="cambiar-este-otro-secreto-tambien-largo-y-aleatorio"
