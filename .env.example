# Base de datos Postgres (ej. Supabase, Neon, Railway).
# DATABASE_URL: conexión "pooled" (para la app en tiempo de ejecución, funciones serverless).
# DIRECT_URL: conexión directa, sin pooler (solo para migraciones).
# En Supabase: Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Contraseña del panel de administración (obligatoria).
ADMIN_PASSWORD="cambiar-esta-contraseña"

# Secreto usado para firmar la cookie de sesión de administrador.
# Generá uno propio, por ejemplo con: openssl rand -hex 32
ADMIN_SESSION_SECRET="cambiar-este-secreto-por-uno-largo-y-aleatorio"
